#!/usr/bin/env bash
set -euo pipefail

worktree_root="$(git rev-parse --show-toplevel)"
hook_dir="$(cd "$(dirname "$0")" && pwd)"
policy_root="$(cd "${hook_dir}/.." && pwd)"

exec python3 "${policy_root}/scripts/repo_sync_guard.py" \
  --repo "${worktree_root}" \
  pre-push \
  --remote-name "$1" \
  --remote-url "$2"
