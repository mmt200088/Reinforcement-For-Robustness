"""
Smoke tests for rescale_optimizer.replan_interface.

Run:
    python scripts/test_replan_interface.py
"""

from __future__ import annotations

import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from rescale_optimizer import (  # noqa: E402
    ReplanSession,
    SUPPORTED_GELU_GRAPH_DEGREES,
    graph_key_for_stage1,
    iter_stage2_graph_targets,
    replan_from_variables,
)


def _check(label: str, ok: bool) -> bool:
    print(f"  [{'PASS' if ok else 'FAIL'}] {label}")
    return ok


def test_session_baseline_call() -> bool:
    print("test_session_baseline_call")
    session = ReplanSession.from_profile(profile="mrpc", include=["block3_exp_n2"])
    out = session.replan("block3_exp_n2")
    return (
        _check("returns dict", isinstance(out, dict))
        and _check("valid", out["valid"] is True)
        and _check("graph_key", out["graph_key"] == "block3_exp_n2")
        and _check("chain total bits", out["result"]["chain"]["total_bits"] > 0)
        and _check("compact config included", "new_compact_config" in out)
    )


def test_session_rich_payload_call() -> bool:
    print("test_session_rich_payload_call")
    session = ReplanSession.from_profile(profile="mrpc", include=["block3_exp_n2"])
    baseline = session.baselines["block3_exp_n2"]
    out = session(
        "block3_exp_n2",
        {
            "t_new": baseline.t_baseline,
            "delta_overrides": {"ctpt_inv_2n": 16},
        },
    )
    applied = out["result"]["applied_delta_overrides"]
    return (
        _check("valid", out["valid"] is True)
        and _check("delta applied", applied.get("ctpt_inv_2n") == 16)
        and _check("t_new echoed", out["t_new"] == baseline.t_baseline)
    )


def test_single_shot_call() -> bool:
    print("test_single_shot_call")
    root = REPO_ROOT
    archive = root / "configs" / "mrpc" / "static_skeletons_mrpc.json"
    cfg = root / "configs" / "mrpc" / "block5_n1.json"
    session = ReplanSession.from_profile(profile="mrpc", include=["block5_n1"])
    baseline = session.baselines["block5_n1"]
    out = replan_from_variables(
        config_path=cfg,
        baseline_archive=archive,
        config_name="block5_n1",
        t_new=baseline.t_baseline,
        delta_overrides={"ctpt_wffn1": 22},
    )
    return (
        _check("returns dict", isinstance(out, dict))
        and _check("valid", out["valid"] is True)
        and _check("delta applied", out["result"]["applied_delta_overrides"].get("ctpt_wffn1") == 22)
    )


def test_block5_n0_replan_call() -> bool:
    print("test_block5_n0_replan_call")
    root = REPO_ROOT
    archive = root / "configs" / "mrpc" / "static_skeletons_mrpc.json"
    cfg = root / "configs" / "mrpc" / "block5_n0.json"
    session = ReplanSession.from_profile(profile="mrpc", include=["block5_n0"])
    baseline = session.baselines["block5_n0"]
    out = replan_from_variables(
        config_path=cfg,
        baseline_archive=archive,
        config_name="block5_n0",
        t_new=baseline.t_baseline,
        delta_overrides={"ctpt_wffn1": 22},
    )
    return (
        _check("degree 0 supported", 0 in SUPPORTED_GELU_GRAPH_DEGREES)
        and _check("session includes block5_n0", session.graph_keys == ["block5_n0"])
        and _check("returns dict", isinstance(out, dict))
        and _check("valid", out["valid"] is True)
        and _check("compact config included", "new_compact_config" in out)
        and _check("delta applied", out["result"]["applied_delta_overrides"].get("ctpt_wffn1") == 22)
    )


def test_stage1_mapping() -> bool:
    print("test_stage1_mapping")
    stage1 = {
        "gelu_degree_per_layer": [0, 1, 4],
        "softmax_degree_per_layer": [2, 5, 6],
    }
    targets = iter_stage2_graph_targets(
        dataset="mrpc",
        num_layers=3,
        stage1_config=stage1,
    )
    keys = {(t["block"], t["layer"]): t["graph_key"] for t in targets}
    return (
        _check("skip block1 layer0", (1, 0) not in keys)
        and _check("block3 layer1", graph_key_for_stage1(
            dataset="mrpc", block=3, layer=1, stage1_config=stage1,
        ) == "block3_exp_n5")
        and _check("block5 layer0 degree0", keys[(5, 0)] == "block5_n0")
        and _check("block5 layer2", keys[(5, 2)] == "block5_n4")
    )


def test_stage1_short_keys_mapping() -> bool:
    print("test_stage1_short_keys_mapping")
    stage1 = {
        "gelu": [1, 2],
        "softmax": [2, 6],
    }
    return (
        _check("short softmax key", graph_key_for_stage1(
            dataset="wnli", block=3, layer=1, stage1_config=stage1,
        ) == "block3_exp_n6")
        and _check("short gelu key", graph_key_for_stage1(
            dataset="wnli", block=5, layer=1, stage1_config=stage1,
        ) == "block5_n2")
    )


def main() -> int:
    tests = [
        test_session_baseline_call,
        test_session_rich_payload_call,
        test_single_shot_call,
        test_block5_n0_replan_call,
        test_stage1_mapping,
        test_stage1_short_keys_mapping,
    ]
    passed = 0
    for test in tests:
        if test():
            passed += 1
        print()
    print(f"summary: {passed} / {len(tests)} tests passed")
    return 0 if passed == len(tests) else 1


if __name__ == "__main__":
    sys.exit(main())
