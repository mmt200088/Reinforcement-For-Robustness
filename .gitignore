ppo_step_info.txt
*.txt
*.log
output.log
*.csv
model_statistics/**/*.png
gelu_analysis/**/*.png
all_analysis/**/*.png
all_analysis_new/**/*.png
!pruning_search_log.txt
# Stage-1 / stage-2 noise: GA (genetic_search_module) & General RL (general_policy_module)
# reuse the same paths as PPO (*.txt is ignored globally above). Un-ignore run artifacts
# under layer_importance_runs (logs + stage-1 ppo_step_info / details shards only).
!rl_results/layer_importance_runs/**/stage1/*.txt
!rl_results/layer_importance_runs/**/stage1/details/*.txt
!rl_results/layer_importance_runs/**/stage2_noise/*.txt
# Stage-2 noise RL: step-info shards (stage2_noise/*.txt does not match details/)
!rl_results/layer_importance_runs/**/stage2_noise/details/*.txt
# Noise RL step dumps are huge; keep them local (overrides un-ignore above for stage2_noise/*.txt)
rl_results/**/noise_ppo_step_info*.txt

# Compare / orchestration runs: track everything under rl_results/runs (overrides global *.txt / *.log / *.csv),
# but keep verbose log streams out of git (only *.log under any .../logs/ directory).
!rl_results/runs/
!rl_results/runs/**
rl_results/runs/**/logs/**/*.log

# Python bytecode / cache (regenerated by interpreter; do not commit)
__pycache__/
*.py[cod]
*$py.class


# ---------------------------------------------------------------------------
# Track all experiment artifacts for sharing via git.
# Note: we still keep global ignores (e.g. *.log/*.txt) for other folders,
# but explicitly un-ignore everything under experiment_results/.
# Re-ignore bulky logs and text dumps under experiment_results/ (GitHub 100MB limit).
# ---------------------------------------------------------------------------
!experiment_results/
!experiment_results/**
experiment_results/**/*.log
experiment_results/**/*.txt
!experiment_results/**/pruning_search_log.txt
