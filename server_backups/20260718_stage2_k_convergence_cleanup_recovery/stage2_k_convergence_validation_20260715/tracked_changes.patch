+def _file_prefix_sha256(path: Any, committed_size: int) -> str:
+    size = int(committed_size)
+    if size < 0:
+        raise ValueError(f"committed size must be non-negative, got {size}")
+    digest = hashlib.sha256()
+    if size == 0 and not os.path.isfile(path):
+        return digest.hexdigest()
+    remaining = size
+    try:
+        with open(path, "rb") as handle:
+            while remaining:
+                chunk = handle.read(min(1024 * 1024, remaining))
+                if not chunk:
+                    raise RuntimeError(
+                        f"checkpoint file {os.fspath(path)!r} is shorter than {size} bytes"
+                    )
+                digest.update(chunk)
+                remaining -= len(chunk)
+    except FileNotFoundError as exc:
+        raise RuntimeError(
+            f"checkpoint file {os.fspath(path)!r} is missing"
+        ) from exc
+    return digest.hexdigest()
+
+
+def checkpoint_file_fingerprints(
+        file_specs: Mapping[str, tuple[Any, int]],
+        ) -> dict[str, str]:
+    """Hash each checkpoint-owned file prefix at its committed byte boundary."""
+    return {
+        str(name): _file_prefix_sha256(path, int(size))
+        for name, (path, size) in sorted(file_specs.items())
+    }
+
+
+def validate_checkpoint_file_fingerprints(
+        expected: Mapping[str, Any],
+        file_specs: Mapping[str, tuple[Any, int]],
+        ) -> None:
+    """Verify persisted stores before any checkpoint-driven truncation."""
+    expected_plain = {str(name): str(value) for name, value in dict(expected).items()}
+    actual = checkpoint_file_fingerprints(file_specs)
+    if actual != expected_plain:
+        raise RuntimeError(
+            "layerwise checkpoint store fingerprint mismatch; start a fresh run"
+        )
+
